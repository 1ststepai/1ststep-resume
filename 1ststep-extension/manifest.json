{
  "manifest_version": 3,
  "name": "1stStep.ai Job Agent",
  "version": "1.6.0",
  "description": "Capture job postings without copy and paste, save them to Job Agent, and fill approved fields on supported pages.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://app.1ststep.ai/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this job to 1stStep.ai",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Capture the job on this page with 1stStep.ai"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://app.1ststep.ai/*"],
      "js": ["auth-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
