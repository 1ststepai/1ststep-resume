# Required for generation. Server-only.
ANTHROPIC_API_KEY=

# Required for paid launch. Server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TIER_SECRET=
BETA_MODE=

# Optional owner restore access. Server-only.
OWNER_ACCESS_EMAILS=
OWNER_ACCESS_SECRET=

# Required for passwordless subscription restore emails. Server-only.
RESEND_API_KEY=
RESEND_FROM=

# LinkedIn OAuth for Sign In with LinkedIn using OpenID Connect. Server-only secrets.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional Agent Analytics public tracker config returned by /api/app-config.
AGENT_ANALYTICS_URL=
AGENT_ANALYTICS_PROJECT=
AGENT_ANALYTICS_TOKEN=

# Optional GHL signup capture and admin notification flow. Server-only.
GHL_API_KEY=
GHL_LOCATION_ID=
