# Required for generation. Server-only.
ANTHROPIC_API_KEY=

# Required for paid launch. Server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate 32-byte-or-stronger HMAC key for durable, pseudonymous Stripe event claims.
STRIPE_WEBHOOK_IDEMPOTENCY_SECRET=
TIER_SECRET=
# Optional managed identity. Identity never grants a paid tier; Stripe remains
# authoritative for product entitlements. Keep disabled until Clerk is provisioned.
CLERK_IDENTITY_ENABLED=false
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_PUBLISHABLE_KEY=
# Required before production provider calls. Provision an Upstash Redis resource
# through the linked Vercel project; keep both values server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Separate 32-byte-or-stronger HMAC key preferred; TIER_SECRET is the fallback.
RATE_LIMIT_HASH_SECRET=
# Optional authoritative relational store. The app remains on its existing
# encrypted Redis persistence until a reviewed migration is run.
JOB_AGENT_POSTGRES_ENABLED=false
DATABASE_URL=
# Required for encrypted beta campaign metadata. Generate 32 random bytes and
# store the base64 value only in Vercel or a gitignored local env file.
BETA_DATA_ENCRYPTION_KEY=
# Safe non-secret identifier for the active key. Change this whenever the key changes.
BETA_DATA_ENCRYPTION_KEY_ID=
# Optional JSON object of up to three prior key IDs and key values used only for
# bounded decryption during a staged rotation. Keep it server-only and remove a
# retired key only after every record using it has expired or been re-encrypted.
BETA_DATA_DECRYPTION_KEYS=
# Private application documents are envelope-encrypted before storage. Both
# storage and the fixed-host internal malware scanner are fail-closed in production.
# Leave disabled locally unless using approved synthetic fixtures. Enabling can incur provider charges.
JOB_AGENT_OBJECT_STORAGE_ENABLED=false
# Supported values: vercel-blob, cloudflare-r2. This selector does not enable storage.
JOB_AGENT_OBJECT_STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
JOB_AGENT_MALWARE_SCANNER_ENABLED=false
JOB_AGENT_MALWARE_SCANNER_URL=
JOB_AGENT_MALWARE_SCANNER_HOST=
JOB_AGENT_MALWARE_SCANNER_BEARER_TOKEN=
# HMAC secret for replay-resistant service-to-service submission and receipt evidence.
JOB_AGENT_RECEIPT_SECRET=
JOB_AGENT_RECEIPT_EMAIL_DOMAINS=
JOB_AGENT_RECEIPT_API_PROVIDERS=
JOB_AGENT_RECEIPT_CAPTURE_ENABLED=false
JOB_AGENT_RECEIPT_CAPTURE_APPROVED=false
JOB_AGENT_RECEIPT_CAPTURE_APPROVAL_VERSION=
JOB_AGENT_RECEIPT_CAPTURE_URL=
JOB_AGENT_RECEIPT_CAPTURE_HOST=
# Comma-separated subset of page,email,api. Each kind needs independent authority evidence.
JOB_AGENT_RECEIPT_CAPTURE_KINDS=
JOB_AGENT_RECEIPT_VERIFICATION_WORKER_ENABLED=false
JOB_AGENT_RECEIPT_VERIFICATION_WORKER_APPROVED=false
JOB_AGENT_RECEIPT_VERIFICATION_WORKER_APPROVAL_VERSION=
# Final submission remains disabled product-wide. These server-only controls only
# configure the single-use provider protocol; durable queue/reconciliation launch
# evidence and the global submission gate are still required before any production use.
JOB_AGENT_FINAL_SUBMISSION_EXECUTION_ENABLED=false
JOB_AGENT_FINAL_SUBMISSION_EXECUTION_APPROVED=false
JOB_AGENT_FINAL_SUBMISSION_EXECUTION_APPROVAL_VERSION=
# The durable queue/worker is an independent launch control. Enabling it can
# contact the configured employer-browser provider and must follow a retained
# supervised run plus explicit deployment authorization.
JOB_AGENT_FINAL_SUBMISSION_DURABLE_EXECUTION_ENABLED=false
JOB_AGENT_FINAL_SUBMISSION_DURABLE_EXECUTION_APPROVED=false
JOB_AGENT_FINAL_SUBMISSION_DURABLE_EXECUTION_APPROVAL_VERSION=
JOB_AGENT_FINAL_SUBMISSION_EXECUTION_EVIDENCE=
JOB_AGENT_CONSENT_ENFORCEMENT=false
JOB_AGENT_COUNSEL_APPROVED=false
JOB_AGENT_TERMS_VERSION=
JOB_AGENT_PRIVACY_VERSION=
JOB_AGENT_AUTHORIZATION_VERSION=
JOB_AGENT_SCHEDULE_ENABLED=false
JOB_AGENT_SCHEDULE_GLOBAL_DAILY_RUNS=
# Separate HMAC key for signed, tamper-evident application audit heads.
JOB_AGENT_AUDIT_SECRET=
# Separate HMAC key for content-free audit-head export bundles.
JOB_AGENT_AUDIT_EXPORT_SECRET=
# Retention archive remains disabled until the provider contract, legal-hold policy,
# storage-lock behavior, and costs are reviewed. The acknowledgement secret must be
# separate from the bearer token and every other application key.
JOB_AGENT_AUDIT_ARCHIVE_ENABLED=false
JOB_AGENT_AUDIT_ARCHIVE_APPROVED=false
JOB_AGENT_AUDIT_ARCHIVE_APPROVAL_VERSION=
JOB_AGENT_AUDIT_ARCHIVE_CONTRACT_VERSION=
JOB_AGENT_AUDIT_ARCHIVE_LEGAL_HOLD_POLICY_VERSION=
JOB_AGENT_AUDIT_ARCHIVE_URL=
JOB_AGENT_AUDIT_ARCHIVE_ALLOWED_HOSTS=
JOB_AGENT_AUDIT_ARCHIVE_BEARER_TOKEN=
JOB_AGENT_AUDIT_ARCHIVE_ACK_SECRET=
JOB_AGENT_AUDIT_ARCHIVE_RETENTION_DAYS=365
JOB_AGENT_AUDIT_ARCHIVE_EVIDENCE=
# Optional user-email prompt for a paused Needs You step. Disabled by default;
# the message contains no employer, role, requisition, question, or candidate data.
JOB_AGENT_NEEDS_YOU_EMAIL_ENABLED=false
# Separate HMAC key for signed, scope-bound controlled-beta launch evidence.
# Evidence envelopes must be created from retained external verification artifacts;
# delivery evidence expires after 30 days and recovery evidence after 90 days.
JOB_AGENT_LAUNCH_EVIDENCE_SECRET=
JOB_AGENT_OBJECT_STORAGE_DRILL_EVIDENCE=
JOB_AGENT_NOTIFICATION_DELIVERY_EVIDENCE=
JOB_AGENT_ALERT_DELIVERY_EVIDENCE=
JOB_AGENT_RECOVERY_DRILL_EVIDENCE=
JOB_AGENT_BACKUP_RESTORE_EVIDENCE=
JOB_AGENT_COST_LIMITS_APPROVED=false
JOB_AGENT_COST_LIMITS_APPROVAL_VERSION=
# Fixed USD-cent reservations. Values are operator-approved worst-case ceilings, never inferred from tokens.
JOB_AGENT_MONETARY_BUDGET_ENABLED=false
JOB_AGENT_MONETARY_BUDGET_APPROVED=false
JOB_AGENT_MONETARY_BUDGET_APPROVAL_VERSION=
JOB_AGENT_MONETARY_BUDGET_CURRENCY=USD
JOB_AGENT_GLOBAL_DAILY_BUDGET_CENTS=
JOB_AGENT_AI_DAILY_BUDGET_CENTS=
JOB_AGENT_AI_MAX_REQUEST_CENTS=
JOB_AGENT_PACKAGE_AI_DAILY_BUDGET_CENTS=
JOB_AGENT_PACKAGE_AI_MAX_REQUEST_CENTS=
JOB_AGENT_DOCUMENT_RENDER_DAILY_BUDGET_CENTS=
JOB_AGENT_DOCUMENT_RENDER_MAX_REQUEST_CENTS=
JOB_AGENT_EMPLOYER_BROWSER_DAILY_BUDGET_CENTS=
JOB_AGENT_EMPLOYER_BROWSER_MAX_SESSION_CENTS=
JOB_AGENT_EMAIL_DAILY_BUDGET_CENTS=
JOB_AGENT_EMAIL_MAX_REQUEST_CENTS=
JOB_AGENT_OBJECT_STORAGE_DAILY_BUDGET_CENTS=
JOB_AGENT_OBJECT_STORAGE_MAX_REQUEST_CENTS=
JOB_AGENT_CONTROLLED_BETA_APPROVED=false
JOB_AGENT_CONTROLLED_BETA_APPROVAL_VERSION=
# Exact reviewed release identity. The runtime SHA-256 comes from security:release-preflight.
# VERCEL_GIT_COMMIT_SHA is supplied by Vercel for Git deployments; never invent it.
JOB_AGENT_RELEASE_RUNTIME_SHA256=
JOB_AGENT_CONTROLLED_BETA_RELEASE_EVIDENCE=
JOB_AGENT_PILOT_MAX_USERS=
JOB_AGENT_PILOT_ENFORCEMENT=false
# Comma-separated 40-character HMAC tenant IDs. Never place candidate emails here.
JOB_AGENT_PILOT_ALLOWED_TENANTS=
# Versioned, fail-closed grant policy. This does not enable a checkout or create a charge.
JOB_AGENT_ACCESS_POLICY_VERSION=
# Controlled-beta legacy tiers that may receive an explicit Job Agent session grant after verified restore.
JOB_AGENT_CONTROLLED_BETA_INCLUDED_TIERS=
JOB_AGENT_EXTENSION_HANDOFF_ENABLED=false
JOB_AGENT_ASSISTED_EXECUTION_MODE=greenhouse-extension
JOB_AGENT_EXTENSION_HANDOFF_SECRET=
JOB_AGENT_GREENHOUSE_EXTENSION_APPROVED=false
JOB_AGENT_GREENHOUSE_EXTENSION_REVIEW_VERSION=
JOB_AGENT_GREENHOUSE_EXTENSION_SHA256=
JOB_AGENT_SUPPORT_OWNER=
JOB_AGENT_INCIDENT_OWNER=
JOB_AGENT_SUPPORT_INCIDENT_APPROVED=false
JOB_AGENT_SUPPORT_INCIDENT_CONTRACT_VERSION=
JOB_AGENT_SUPPORT_COVERAGE_VERSION=
JOB_AGENT_INCIDENT_ESCALATION_POLICY_VERSION=
JOB_AGENT_INCIDENT_RUNBOOK_VERSION=
JOB_AGENT_INCIDENT_RUNBOOK_SHA256=
# Optional JSON override for reviewed Greenhouse, Lever, and Ashby employer feeds.
CONCIERGE_PUBLIC_ATS_SOURCES=
# Optional hard global budgets, measured in weighted request units per UTC day.
AI_GLOBAL_DAILY_UNITS=20000
CLAUDE_GLOBAL_DAILY_UNITS=30000
JOB_SEARCH_GLOBAL_DAILY_CALLS=10000
DISCOVERY_GLOBAL_DAILY_CALLS=5000
PACKAGE_GLOBAL_DAILY_UNITS=300
DOCUMENT_RENDER_SANDBOX_ENABLED=false
DOCUMENT_RENDER_SANDBOX_SNAPSHOT_ID=
DOCUMENT_RENDER_ACCOUNT_DAILY_UNITS=10
DOCUMENT_RENDER_GLOBAL_DAILY_UNITS=100
# Employer browser execution is disabled by default. Enabling a Sandbox worker can incur charges.
# Require a reviewed snapshot, employer/ATS terms, fixture acceptance, incident controls, and budgets first.
EMPLOYER_BROWSER_WORKER_ENABLED=false
EMPLOYER_BROWSER_WORKER_SNAPSHOT_ID=
EMPLOYER_BROWSER_ACCOUNT_DAILY_UNITS=5
EMPLOYER_BROWSER_GLOBAL_DAILY_UNITS=30
EMPLOYER_BROWSER_WORKER_RUNNER_VERSION=
EMPLOYER_BROWSER_WORKER_RUNNER_SHA256=
EMPLOYER_BROWSER_WORKER_RUNNER_PATH=/opt/1ststep/employer-browser-runner.mjs
EMPLOYER_BROWSER_DURABLE_EXECUTION_ENABLED=false
# Signed retained evidence binds the reviewed runner to the exact configured snapshot, runner, and SHA-256.
EMPLOYER_BROWSER_RUNNER_EVIDENCE=
EMPLOYER_TERMS_REVIEW_VERSION=
JOB_AGENT_ASSISTED_APPLICATION_APPROVED=false
JOB_AGENT_ASSISTED_APPLICATION_APPROVAL_VERSION=
# Local/dev-only static browser-handoff fixture. Production rejects this provider.
EMPLOYER_BROWSER_SESSION_PROVIDER=
EMPLOYER_BROWSER_SESSION_FIXTURE_ENABLED=false
# Vendor-neutral HTTPS session API. Keep disabled until provider terms, spend, CSP origin, and recovery are approved.
EMPLOYER_BROWSER_REMOTE_STREAM_ENABLED=false
EMPLOYER_BROWSER_REMOTE_STREAM_API_URL=
EMPLOYER_BROWSER_REMOTE_STREAM_ORIGIN=
EMPLOYER_BROWSER_REMOTE_STREAM_API_KEY=
EMPLOYER_BROWSER_PROVIDER_COSTS_APPROVED=false
EMPLOYER_BROWSER_PROVIDER_COSTS_APPROVAL_VERSION=
EMPLOYER_BROWSER_REMOTE_STREAM_CSP_APPROVED=false
EMPLOYER_BROWSER_REMOTE_STREAM_CSP_APPROVAL_VERSION=
EMPLOYER_BROWSER_REMOTE_STREAM_CSP_APPROVED_ORIGIN=
EMPLOYER_BROWSER_SESSION_RECOVERY_EVIDENCE=
# Optional content-free incident webhook. No event is sent unless all three
# values are configured; the exact HTTPS hostname must be allowlisted.
JOB_AGENT_ALERT_WEBHOOK_URL=
JOB_AGENT_ALERT_ALLOWED_HOSTS=
JOB_AGENT_ALERT_BEARER_TOKEN=
JOB_AGENT_ALERT_CONTRACT_VERSION=
JOB_AGENT_ALERT_COOLDOWN_SECONDS=900
BETA_MODE=
BETA_CODE=
CRON_SECRET=
HEALTH_CHECK_SECRET=
TALLY_SIGNING_SECRET=
# Exact comma-separated Chrome/Firefox extension IDs. Never use wildcards.
ALLOWED_EXTENSION_IDS=

# Optional owner restore access. Server-only.
OWNER_ACCESS_EMAILS=
OWNER_ACCESS_SECRET=

# Required for passwordless subscription restore emails. Server-only.
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
JOB_AGENT_EMAIL_SUPPRESSION_TTL_DAYS=365

# LinkedIn OAuth for Sign In with LinkedIn using OpenID Connect. Server-only secrets.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional server-side AI routing. Provider secrets must never be exposed to clients.
AI_PROVIDER=
AI_FAST_MODEL=
AI_QUALITY_MODEL=
# Optional task routing. Candidate-sensitive and application-package tasks default
# to Anthropic when its key is available. DeepSeek is deliberately restricted to
# routine, non-candidate-sensitive tasks and remains disabled without all three
# versioned approval controls. Do not enable with real user data until privacy and
# legal review is complete.
AI_ROUTINE_PROVIDER=
AI_ROUTINE_MODEL=
AI_DOCUMENT_PROVIDER=
AI_DOCUMENT_MODEL=
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_DEEPSEEK_ROUTING_ENABLED=false
AI_DEEPSEEK_ROUTING_APPROVED=false
AI_DEEPSEEK_ROUTING_APPROVAL_VERSION=
DEEPSEEK_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENAI_API_KEY=
AI_API_KEY=
AI_BASE_URL=
# JSON array of fixed Greenhouse, Lever, or Ashby employer-board identifiers.
CONCIERGE_PUBLIC_ATS_SOURCES=

# Optional GHL signup capture and admin notification flow. Server-only.
GHL_API_KEY=
GHL_LOCATION_ID=
# Controlled learning is separate from Job Agent execution. Keep both disabled
# until the verified evaluation dataset and operator rollout are approved.
JOB_AGENT_LEARNING_ENABLED=false
JOB_AGENT_LEARNING_AUTO_PROMOTION_ENABLED=false
HEALTH_LEGACY_ADMIN_ACTIONS_ENABLED=false
